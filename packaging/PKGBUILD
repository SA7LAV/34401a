# Maintainer: Kalle Hagen <dev@hammarang-solutions.se>
#
# Build from source:
#   cd packaging && makepkg -f
pkgname=hp34401a-gui
pkgver=1.1.4
pkgrel=1
pkgdesc="Linux GUI for HP/Agilent/Keysight 34401A Multimeter"
arch=('x86_64')
url="https://git.cls.net/kalle/Agilent_34401a_GUI"
license=('MIT')
depends=('qt6-base' 'qt6-serialport')
makedepends=('cmake' 'ninja')
source=()
sha256sums=()

build() {
    ROOT="$(cd "$startdir/.." && pwd)"
    cmake -B "$ROOT/build" -S "$ROOT" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -GNinja
    ninja -C "$ROOT/build"
}

package() {
    ROOT="$(cd "$startdir/.." && pwd)"
    DESTDIR="$pkgdir" ninja -C "$ROOT/build" install

    install -Dm644 "$ROOT/assets/hp34401a.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/hp34401a.png"
}
